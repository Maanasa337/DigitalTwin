# Keycloak base URL reachable from the browser
VITE_KEYCLOAK_URL=http://localhost:8081
# Development/test escape hatch only: fake user with all roles, no token. Never enable in production.
VITE_AUTH_DISABLED=false
# Grafana base path as seen by the browser. Defaults to the same-origin /grafana proxy.
VITE_GRAFANA_URL=/grafana
