{# Print layout for every report type. Light theme, Section 9 tokens, A4 with page numbers. #}
<!doctype html>
<html lang="{{ lang|default('en') }}">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <style>
    :root {
      --ink: #0b0b0b;
      --ink-2: #52514e;
      --muted: #898781;
      --line: #e1e0d9;
      --surface: #ffffff;
      --brand: #2a78d6;
      --good: #006300;
      --warning: #fab219;
      --serious: #ec835a;
      --critical: #d03b3b;
    }
    @page {
      size: A4;
      margin: 18mm 16mm 20mm 16mm;
      @bottom-right { content: counter(page) " / " counter(pages); font-size: 9pt; color: #898781; }
      @bottom-left  { content: "{{ title }}"; font-size: 9pt; color: #898781; }
    }
    body {
      font-family: Inter, system-ui, "Segoe UI", sans-serif;
      font-size: 10.5pt;
      line-height: 1.45;
      color: var(--ink);
      background: var(--surface);
      margin: 0;
    }
    header { border-bottom: 2px solid var(--brand); padding-bottom: 10px; margin-bottom: 18px; }
    h1 { font-size: 20pt; margin: 0 0 4px; }
    h2 { font-size: 13pt; margin: 22px 0 8px; color: var(--ink); }
    .meta { color: var(--ink-2); font-size: 9.5pt; }
    .summary {
      background: #f7f8fa;
      border-left: 3px solid var(--brand);
      padding: 12px 14px;
      margin: 0 0 18px;
    }
    .summary p { margin: 0; }
    .summary .provenance { margin-top: 8px; font-size: 8.5pt; color: var(--muted); }
    .tiles { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
    .tile {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 10px 12px;
      min-width: 108px;
    }
    .tile .label { font-size: 8.5pt; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
    .tile .value { font-size: 17pt; font-variant-numeric: tabular-nums; }
    .tile .unit { font-size: 9pt; color: var(--ink-2); margin-left: 3px; }
    table { width: 100%; border-collapse: collapse; font-size: 9.5pt; font-variant-numeric: tabular-nums; }
    th, td { text-align: left; padding: 5px 6px; border-bottom: 1px solid var(--line); }
    th { color: var(--ink-2); font-weight: 600; background: #f7f8fa; }
    img.chart { width: 100%; max-height: 74mm; object-fit: contain; margin: 6px 0 4px; }
    .status { font-weight: 600; }
    .status--good { color: var(--good); }
    .status--warning { color: #8a6200; }
    .status--serious { color: #a1421a; }
    .status--critical { color: var(--critical); }
    .empty { color: var(--muted); font-style: italic; }
    footer { margin-top: 24px; padding-top: 8px; border-top: 1px solid var(--line); font-size: 8.5pt; color: var(--muted); }
  </style>
</head>
<body>
  <header>
    <h1>{{ title }}</h1>
    <div class="meta">
      {{ scope_name }}
      {%- if period_start %} · {{ period_start.strftime('%d %b %Y %H:%M') }} to {{ period_end.strftime('%d %b %Y %H:%M') }}{% endif %}
      · generated {{ generated_at.strftime('%d %b %Y %H:%M %Z') }}
    </div>
  </header>

  <div class="summary">
    <p>{{ summary_text }}</p>
    <div class="provenance">
      {%- if summary_audit.used_llm -%}
        Summary drafted by {{ llm_model }} and checked against the figures below.
      {%- else -%}
        Summary generated from the figures below.
      {%- endif -%}
      {%- if not summary_audit.passed %} The drafted text failed the numeric check ({{ summary_audit.reason }}) and was replaced.{% endif %}
    </div>
  </div>

  {% block content %}{% endblock %}

  <footer>
    TwinVoice · report {{ report_id }} · every figure is read from the platform database at generation time.
  </footer>
</body>
</html>
