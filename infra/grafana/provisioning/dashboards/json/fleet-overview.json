{
  "uid": "tv-fleet",
  "title": "Fleet overview",
  "description": "Every asset's latest health and RUL, active alarms by severity and power per line.",
  "tags": [
    "twinvoice"
  ],
  "editable": false,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "style": "dark",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "fiscalYearStartMonth": 0,
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active alarms by severity",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE severity = 'critical') AS \"Critical\", count(*) FILTER (WHERE severity = 'serious') AS \"Serious\", count(*) FILTER (WHERE severity = 'warning') AS \"Warning\", count(*) FILTER (WHERE severity = 'info') AS \"Info\" FROM alarms WHERE status IN ('active','acknowledged')",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "fixedColor": "#898781",
            "mode": "fixed"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#d03b3b",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Serious"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ec835a",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#fab219",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#898781",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet power now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(x.power_kw) AS \"Fleet power\" FROM assets a CROSS JOIN LATERAL (SELECT e.power_kw FROM energy_readings e WHERE e.asset_id = a.id AND e.time > now() - interval '5 minutes' ORDER BY e.time DESC LIMIT 1) x WHERE a.deleted_at IS NULL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean fleet health",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(x.health_index)::float AS \"Mean health\" FROM assets a CROSS JOIN LATERAL (SELECT p.health_index FROM predictions p WHERE p.asset_id = a.id ORDER BY p.time DESC LIMIT 1) x WHERE a.deleted_at IS NULL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 40
              },
              {
                "color": "#fab219",
                "value": 60
              },
              {
                "color": "#0ca30c",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Assets",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.code AS \"Asset\", a.name AS \"Name\", l.name AS \"Line\", a.status AS \"Status\", p.health_index::float AS \"Health\", p.rul_point AS \"RUL\", p.confidence_label AS \"Confidence\", (SELECT count(*) FROM alarms al WHERE al.asset_id = a.id AND al.status IN ('active','acknowledged')) AS \"Active alarms\", p.time AS \"Predicted at\" FROM assets a LEFT JOIN lines l ON l.id = a.line_id LEFT JOIN LATERAL (SELECT * FROM predictions pr WHERE pr.asset_id = a.id ORDER BY pr.time DESC LIMIT 1) p ON true WHERE a.deleted_at IS NULL ORDER BY a.code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Asset"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open asset overview",
                    "url": "/grafana/d/tv-asset/asset-overview?var-asset=${__value.raw}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "#0ca30c",
                        "index": 0
                      },
                      "IDLE": {
                        "color": "#fab219",
                        "index": 1
                      },
                      "MAINTENANCE": {
                        "color": "#ec835a",
                        "index": 2
                      },
                      "DOWN": {
                        "color": "#d03b3b",
                        "index": 3
                      },
                      "UNKNOWN": {
                        "color": "#898781",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#d03b3b",
                      "value": null
                    },
                    {
                      "color": "#ec835a",
                      "value": 40
                    },
                    {
                      "color": "#fab219",
                      "value": 60
                    },
                    {
                      "color": "#0ca30c",
                      "value": 80
                    }
                  ]
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RUL"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: cycles"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Active alarms"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Predicted at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Power by line",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT x.time AS \"time\", x.line AS metric, sum(x.p) AS value FROM ( SELECT $__timeGroup(e.time, $__interval) AS time, l.name AS line, e.asset_id, avg(e.power_kw) AS p FROM energy_readings e JOIN assets a ON a.id = e.asset_id AND a.deleted_at IS NULL JOIN lines l ON l.id = a.line_id WHERE $__timeFilter(e.time) GROUP BY 1, 2, 3) x GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "none"
          },
          "unit": "kwatt",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Machining Line"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3987e5",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Forming Line"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#d95926",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Sum of per-asset mean power, grouped by production line."
    }
  ],
  "templating": {
    "list": []
  }
}
