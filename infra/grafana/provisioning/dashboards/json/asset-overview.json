{
  "uid": "tv-asset",
  "title": "Asset overview",
  "description": "Health, RUL, power, alarms and sensor history for one asset.",
  "tags": [
    "twinvoice"
  ],
  "editable": false,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "style": "dark",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "fiscalYearStartMonth": 0,
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Health index",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.time AS \"time\", p.health_index::float AS \"Health index\" FROM predictions p JOIN assets a ON a.id = p.asset_id AND a.code = '$asset' ORDER BY p.time DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#ec835a",
                "value": 40
              },
              {
                "color": "#fab219",
                "value": 60
              },
              {
                "color": "#0ca30c",
                "value": 80
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Latest health index (0–100) from the most recent prediction."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Remaining useful life",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.time AS \"time\", p.rul_point AS \"RUL\" FROM predictions p JOIN assets a ON a.id = p.asset_id AND a.code = '$asset' WHERE p.rul_point IS NOT NULL ORDER BY p.time DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: cycles",
          "decimals": 0,
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Latest RUL point estimate."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active alarms",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Active alarms\" FROM alarms al JOIN assets a ON a.id = al.asset_id AND a.code = '$asset' WHERE al.status IN ('active','acknowledged')",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Alarms that are active or acknowledged (not cleared or shelved)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Power now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.time AS \"time\", e.power_kw AS \"Power\" FROM energy_readings e JOIN assets a ON a.id = e.asset_id AND a.code = '$asset' ORDER BY e.time DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "decimals": 1,
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Health index over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.time AS \"time\", p.health_index::float AS \"Health index\" FROM predictions p JOIN assets a ON a.id = p.asset_id AND a.code = '$asset' WHERE $__timeFilter(p.time) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "gradientMode": "none",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b1a",
                "value": null
              },
              {
                "color": "#ec835a14",
                "value": 40
              },
              {
                "color": "#fab21910",
                "value": 60
              },
              {
                "color": "transparent",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
