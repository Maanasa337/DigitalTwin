      "type": "timeseries",
      "title": "RUL with 90 % band",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tv-timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tv-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT p.time AS \"time\", p.rul_point AS \"RUL\", p.rul_low AS \"RUL low\", p.rul_high AS \"RUL high\" FROM predictions p JOIN assets a ON a.id = p.asset_id AND a.code = '$asset' WHERE $__timeFilter(p.time) AND p.rul_point IS NOT NULL ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3987e5",
            "mode": "fixed"
          },
          "custom": {
