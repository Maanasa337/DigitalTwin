# Copy to .env to override docker compose defaults.

# Host port for PostgreSQL (5432 is often taken by a local install).
TV_PG_HOST_PORT=5433

# Eclipse Ditto image tag.
DITTO_VERSION=3.9.0

# Tier-T3 twin write-back (set_load, set_speed, maintenance_reset) needs this AND the user's PIN
# (Keycloak user attribute tv_pin; demo users marcus=246810, admin=135790).
TV_ALLOW_T3=false
