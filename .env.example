# Copy to .env to override docker compose defaults.

# Host port for PostgreSQL (5432 is often taken by a local install).
TV_PG_HOST_PORT=5433

# Eclipse Ditto image tag.
DITTO_VERSION=3.9.0

# Tier-T3 twin write-back (set_load, set_speed, maintenance_reset) needs this AND the user's PIN
# (Keycloak user attribute tv_pin; demo users marcus=246810, admin=135790).
TV_ALLOW_T3=false

# Grafana (optional engineer dashboards at http://localhost:8088/grafana/, or directly on :3000).
GRAFANA_VERSION=13.0.2
GRAFANA_ADMIN_PASSWORD=admin
# Password of the read-only grafana_ro database role. Compose passes it to the api as
# TV_GRAFANA_DB_PASSWORD (Alembic 0010 sets the role's password on `alembic upgrade`) and to
# Grafana's datasource, so both always match. After changing it, restart api then grafana.
GRAFANA_DB_PASSWORD=grafana_ro
# Absolute URL Grafana uses for redirects; change it if the web container is not on :8088.
GRAFANA_ROOT_URL=http://localhost:8088/grafana/
